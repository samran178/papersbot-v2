# Copy this file to .env (same folder) and fill in the values.

# True on your laptop, False on a real server.
DEBUG=True

# Required when DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://papersbot:papersbot@localhost:5432/papersbot

# Comma-separated. Add your domain in production, e.g. papersbot.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with https://) that may submit forms, e.g. https://papersbot.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Optional: enables AI question generation and AI grading suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Leave empty for api.openai.com; set only for an OpenAI-compatible proxy.
OPENAI_BASE_URL=
